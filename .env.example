# Environment variables — copy to `.env` at repository root

# ── Database (local Docker) ──────────────────────────────────────────
DATABASE_URL="postgresql://freshy:freshy_dev@localhost:5432/freshy?schema=public"

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"

# ── Web (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Google Cloud Storage ─────────────────────────────────────────────
GCP_PROJECT_ID=
GCS_BUCKET_NAME=freshy-assets
GOOGLE_APPLICATION_CREDENTIALS=

# ── Maps (optional for Phase 1+) ─────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Expo / EAS (mobile releases) ─────────────────────────────────────
EXPO_TOKEN=
