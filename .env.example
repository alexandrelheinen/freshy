# Environment variables — copy to `.env` at repository root

# ── Web (Next.js) ────────────────────────────────────────────────────
# Production: Cloudflare Worker URL (see docs/platforms.md)
NEXT_PUBLIC_API_URL="http://localhost:8787"

# ── Cloudflare R2 (object storage) ───────────────────────────────────
# Production: native R2 binding on Worker (FRESHY_ASSETS). These vars are for
# CI uploads and optional local S3-compatible access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freshy-assets
R2_PUBLIC_URL=
# Same public base as R2_PUBLIC_URL — used by the web app for default place photos
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── GitHub Actions CD (optional secrets) ─────────────────────────────
# CLOUDFLARE_API_TOKEN — Worker deploy + D1 migrations on main
# CLOUDFLARE_ACCOUNT_ID — Wrangler account ID
# R2_* — CI screenshot uploads and place-default sync

# ── Maps (Mapbox) ────────────────────────────────────────────────────
# Public token for web maps (Cloudflare Pages)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server token for geocoding on place submit (Worker secret). Can match the public token.
MAPBOX_ACCESS_TOKEN=

# ── Auth (Clerk) ─────────────────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys
# Worker secrets: set in packages/api/.dev.vars for local dev, or Worker dashboard for production
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated frontend origins (required in production for cross-origin API calls)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://freshy-25e.pages.dev

# ── Expo / EAS (mobile releases) ─────────────────────────────────────
EXPO_TOKEN=
