# Environment variables — copy to `.env` at repository root

# ── Database (local Docker) ──────────────────────────────────────────
# Production: Neon/Supabase URI — see docs/database.md and docs/deploy-api.md
DATABASE_URL="postgresql://freshy:freshy_dev@localhost:5432/freshy?schema=public"

# ── API ──────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
# Render/Railway set PORT automatically; API reads PORT or API_PORT

# ── Web (Next.js) ────────────────────────────────────────────────────
# Production: your deployed API URL (e.g. https://freshy-api.onrender.com) — NOT a Pages URL
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Cloudflare R2 (object storage) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freshy-assets
R2_PUBLIC_URL=
# Same public base as R2_PUBLIC_URL — used by the web app for default place photos
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Maps (optional for Phase 1+) ─────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Auth (Clerk — Full v0) ───────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated frontend origins (required in production for cross-origin API calls)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://freshy-25e.pages.dev

# ── Expo / EAS (mobile releases) ─────────────────────────────────────
EXPO_TOKEN=
