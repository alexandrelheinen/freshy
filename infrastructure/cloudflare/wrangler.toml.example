# Example Wrangler config for Freshy API (Workers) + D1 + R2
# Production config lives at packages/api/wrangler.toml

name = "freshy-api"
main = "src/worker.ts"
compatibility_date = "2026-06-30"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "FRESHY_DB"
database_name = "freshy-db"
database_id = "<your-d1-database-id>"
migrations_dir = "../db/migrations"

[[r2_buckets]]
binding = "FRESHY_ASSETS"
bucket_name = "freshy-assets"

[vars]
R2_PUBLIC_URL = "https://pub-<hash>.r2.dev"

# Secrets (set via dashboard or wrangler secret put):
# - CLERK_SECRET_KEY
# - CLERK_AUTHORIZED_PARTIES
# - MAPBOX_ACCESS_TOKEN
