{
  "name": "freshy",
  "version": "0.1.0",
  "private": true,
  "description": "Freshy | cooling map for urban thermal comfort",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint apps packages --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @freshy/db generate",
    "db:migrate": "pnpm --filter @freshy/db migrate",
    "db:seed": "pnpm --filter @freshy/db seed",
    "build:api": "pnpm db:generate && pnpm --filter @freshy/db build && pnpm --filter @freshy/api build",
    "start:api": "node packages/api/dist/server.js",
    "screenshots": "pnpm --filter @freshy/web screenshots",
    "upload:place-defaults": "tsx scripts/upload-place-defaults.ts"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "~19.0.2",
      "@types/react-dom": "~19.0.2"
    }
  }
}
