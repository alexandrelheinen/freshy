{
  "name": "@freshy/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "tsc --noEmit",
    "build:android": "eas build --platform android --non-interactive",
    "build:ios": "eas build --platform ios --non-interactive",
    "lint": "eslint app src --config ../../eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "bash ../../scripts/run-ts-tests.sh src"
  },
  "dependencies": {
    "@freshy/ui": "workspace:*",
    "expo": "~52.0.23",
    "expo-router": "~4.0.15",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@freshy/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
