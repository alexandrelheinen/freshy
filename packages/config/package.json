{
  "name": "@freshy/config",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./pilot-city": "./pilot-city.js",
    "./map-search": "./map-search.js",
    "./place-photos": {
      "types": "./place-photos.ts",
      "import": "./place-photos.ts",
      "require": "./dist/place-photos.js",
      "default": "./place-photos.ts"
    },
    "./place-tags": {
      "types": "./place-tags.ts",
      "import": "./place-tags.ts",
      "require": "./dist/place-tags.js",
      "default": "./place-tags.ts"
    },
    "./freshness-levels": {
      "types": "./freshness-levels.ts",
      "import": "./freshness-levels.ts",
      "require": "./dist/freshness-levels.js",
      "default": "./freshness-levels.ts"
    },
    "./tailwind": "./tailwind.preset.ts"
  },
  "scripts": {
    "build": "pnpm --filter @freshy/theme build && tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @freshy/theme build && tsx --test place-photos.test.ts place-tags.test.ts freshness-levels.test.ts tailwind.preset.test.ts"
  },
  "dependencies": {
    "@freshy/theme": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
