{
  "name": "@freshy/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --config ../../eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "bash ../../scripts/run-ts-tests.sh src",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@freshy/config": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@freshy/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
